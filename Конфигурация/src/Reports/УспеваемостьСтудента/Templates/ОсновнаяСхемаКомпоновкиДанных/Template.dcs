					<dcsset:right xsi:nil="true"/>
					<dcsset:userSettingID>acf8c812-46ef-4b7f-b08d-103028fcfafd</dcsset:userSettingID>
				</dcsset:item>
			</dcsset:filter>
			<dcsset:order>
				<dcsset:item xsi:type="dcsset:OrderItemField">
					<dcsset:field>Студент</dcsset:field>
					<dcsset:orderType>Asc</dcsset:orderType>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:OrderItemField">
					<dcsset:field>Дисциплина</dcsset:field>
					<dcsset:orderType>Asc</dcsset:orderType>
