Функция СоздатьОтветСОшибкой(ТекстОшибки, КодСостояния = 400)

	ТелоОтвета = РаботаСJSONСервер.СформироватьОтветСОшибкой(ТекстОшибки, КодСостояния);
	Возврат СоздатьОтветJSON(ТелоОтвета, КодСостояния);

КонецФункции

Функция ПроверитьДоступИВернутьОшибку(HTTPЗапрос, МетодAPI, АдресЗапроса, РезультатПроверки)

	РезультатПроверки = ПроверкаДоступаAPISервер.ПроверитьДоступНаЧтение(HTTPЗапрос);

	Если РезультатПроверки.Разрешен Тогда
		Возврат Неопределено;
	КонецЕсли;

	РаботаСWebAPISервер.ЗаписатьИсториюВызоваAPI(МетодAPI, Ложь, РезультатПроверки.КодОтвета, РезультатПроверки.Сообщение, АдресЗапроса, РезультатПроверки.ВнешняяСистема);

	Возврат СоздатьОтветСОшибкой(РезультатПроверки.Сообщение, РезультатПроверки.КодОтвета);

КонецФункции

Функция СоздатьОтветСДанными(Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();

	ЗаписатьJSON(ЗаписьJSON, Данные);

	ТелоОтвета = ЗаписьJSON.Закрыть();

	Возврат СоздатьОтветJSON(ТелоОтвета, 200);

КонецФункции


Функция СоздатьОтветJSON(ТелоОтвета, КодСостояния = 200)

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета, КодировкаТекста.UTF8);

	Возврат Ответ;

КонецФункции