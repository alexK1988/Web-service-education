Функция requestsPostRequest(HTTPЗапрос)
	РезультатПроверки = ПроверкаДоступаAPISервер.ПроверитьДоступНаЗапись(HTTPЗапрос);

	Если НЕ РезультатПроверки.Разрешен Тогда
		РаботаСWebAPISервер.ЗаписатьИсториюВызоваAPI("requests", Ложь, РезультатПроверки.КодОтвета, РезультатПроверки.Сообщение, "/requests", РезультатПроверки.ВнешняяСистема);
		Возврат СоздатьОтветСОшибкой(РезультатПроверки.Сообщение, РезультатПроверки.КодОтвета);
	КонецЕсли;

	Попытка

		ТелоЗапроса = HTTPЗапрос.ПолучитьТелоКакСтроку();

		Если ПустаяСтрока(СокрЛП(ТелоЗапроса)) Тогда
			РаботаСWebAPISервер.ЗаписатьИсториюВызоваAPI("requests", Ложь, 400, "Тело запроса не заполнено", "/requests", РезультатПроверки.ВнешняяСистема);
			Возврат СоздатьОтветСОшибкой("Тело запроса не заполнено", 400);
		КонецЕсли;

		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(ТелоЗапроса);
			Данные = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
		Исключение
			РаботаСWebAPISервер.ЗаписатьИсториюВызоваAPI("requests", Ложь, 400, "Некорректный JSON", "/requests", РезультатПроверки.ВнешняяСистема);
			Возврат СоздатьОтветСОшибкой("Некорректный JSON", 400);
		КонецПопытки;

		ОшибкаВалидации = РаботаСWebAPISервер.ПроверитьДанныеОбращения(Данные);

		Если НЕ ПустаяСтрока(ОшибкаВалидации) Тогда
			РаботаСWebAPISервер.ЗаписатьИсториюВызоваAPI("requests", Ложь, 400, ОшибкаВалидации, "/requests", РезультатПроверки.ВнешняяСистема);
			Возврат СоздатьОтветСОшибкой(ОшибкаВалидации, 400);
		КонецЕсли;

		ПроверкаСтудента = РаботаСWebAPISервер.ПроверитьСтудентаПоИдентификатору(Данные.student_id);

		Если НЕ ПроверкаСтудента.Успешно Тогда
			РаботаСWebAPISервер.ЗаписатьИсториюВызоваAPI("requests", Ложь, ПроверкаСтудента.Код, ПроверкаСтудента.Сообщение, "/requests", РезультатПроверки.ВнешняяСистема);
			Возврат СоздатьОтветСОшибкой(ПроверкаСтудента.Сообщение, ПроверкаСтудента.Код);
		КонецЕсли;

		Результат = РаботаСWebAPISервер.СоздатьОбращениеСтудента(Данные, ПроверкаСтудента.Студент);

		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Результат);
		ТелоОтвета = Запись.Закрыть();

		РаботаСWebAPISервер.ЗаписатьИсториюВызоваAPI("requests", Истина, 201, "", "/requests", РезультатПроверки.ВнешняяСистема);

		Возврат СоздатьОтветJSON(ТелоОтвета, 201);

	Исключение

		ТекстОшибки = ОписаниеОшибки();

		РаботаСWebAPISервер.ЗаписатьИсториюВызоваAPI("requests", Ложь, 500, ТекстОшибки, "/requests", РезультатПроверки.ВнешняяСистема);

		Возврат СоздатьОтветСОшибкой(ТекстОшибки, 500);

	КонецПопытки;
КонецФункции

