		ФормируемаяЗадача.Наименование = "Рассмотреть обращение студента";
		ФормируемаяЗадача.ОписаниеЗадачи = "Рассмотреть обращение студента";

		Если ЗначениеЗаполнено(Обращение) Тогда
			ФормируемаяЗадача.ОписаниеЗадачи = "Рассмотреть обращение студента: " + Строка(Обращение);
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Процедура ПодготовитьОтветПриВыполнении(ТочкаМаршрута, Задача, Отказ)
		
	Если НЕ ЗначениеЗаполнено(Обращение) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		ОбращениеОбъект = Обращение.ПолучитьОбъект();

		ОбращениеОбъект.Статус = Перечисления.СтатусыОбращения.Выполнено;

		Если НЕ ПустаяСтрока(СокрЛП(Строка(Задача.КомментарийИсполнителя))) Тогда
			ОбращениеОбъект.Ответ = Задача.КомментарийИсполнителя;
		КонецЕсли;

		ОбращениеОбъект.Записать();

		Завершено = Истина;

	Исключение

		Сообщить("Не удалось завершить обработку обращения: " + ОписаниеОшибки());
		Отказ = Истина;

	КонецПопытки;
	
КонецПроцедуры

Процедура РассмотретьОбращениеПриВыполнении(ТочкаМаршрута, Задача, Отказ)
	
	Если НЕ ЗначениеЗаполнено(Обращение) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		ОбращениеОбъект = Обращение.ПолучитьОбъект();

		ОбращениеОбъект.Статус = Перечисления.СтатусыОбращения.ВРаботе;
		ОбращениеОбъект.Записать();

	Исключение

		Сообщить("Не удалось изменить статус обращения: " + ОписаниеОшибки());
		Отказ = Истина;

	КонецПопытки;
	
КонецПроцедуры

