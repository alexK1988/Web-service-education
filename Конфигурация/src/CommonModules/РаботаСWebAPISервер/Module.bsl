Процедура ЗаписатьИсториюВызоваAPI(МетодAPI, Успешно, КодОтвета, ТекстОшибки, АдресЗапроса, ВнешняяСистема = Неопределено) Экспорт

	ЗаписьИстории = РегистрыСведений.ИсторияВызововAPI.СоздатьМенеджерЗаписи();

	ЗаписьИстории.Период = ТекущаяДата();
	ЗаписьИстории.ИдентификаторВызова = Строка(Новый УникальныйИдентификатор);

	Если ВнешняяСистема <> Неопределено И ЗначениеЗаполнено(ВнешняяСистема) Тогда
		ЗаписьИстории.ВнешняяСистема = ВнешняяСистема;
	КонецЕсли;

	ЗаписьИстории.МетодAPI = МетодAPI;
	ЗаписьИстории.Успешно = Успешно;
	ЗаписьИстории.КодОтвета = КодОтвета;
	ЗаписьИстории.ТекстОшибки = ТекстОшибки;
	ЗаписьИстории.АдресЗапроса = АдресЗапроса;

	ЗаписьИстории.Записать();

КонецПроцедуры

Функция СоздатьОбращениеСтудента(Данные, Студент) Экспорт

	СтудентОбъект = Студент.ПолучитьОбъект();

	Обращение = Документы.ОбращениеСтудента.СоздатьДокумент();
	Обращение.Дата = ТекущаяДата();
	Обращение.Студент = Студент;
	Обращение.УчебнаяГруппа = СтудентОбъект.УчебнаяГруппа;
	Обращение.ТемаОбращения = Строка(Данные.subject);
	Обращение.ТекстОбращения = Строка(Данные.text);
	Обращение.Статус = Перечисления.СтатусыОбращения.Новое;

	Обращение.Записать();

	Результат = Новый Структура;
	Результат.Вставить("id", Строка(Обращение.Ссылка.УникальныйИдентификатор()));
	Результат.Вставить("number", Обращение.Номер);
	Результат.Вставить("date", Обращение.Дата);
	Результат.Вставить("status", Строка(Обращение.Статус));

	Возврат Результат;

КонецФункции

Функция ПроверитьДанныеОбращения(Данные) Экспорт

	Если НЕ Данные.Свойство("student_id") Или ПустаяСтрока(Строка(Данные.student_id)) Тогда
		Возврат "Не указан student_id";
	КонецЕсли;

	Если НЕ Данные.Свойство("subject") Или ПустаяСтрока(Строка(Данные.subject)) Тогда
		Возврат "Не указана тема обращения";
	КонецЕсли;

	Если НЕ Данные.Свойство("text") Или ПустаяСтрока(Строка(Данные.text)) Тогда
		Возврат "Не указан текст обращения";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПроверитьСтудентаПоИдентификатору(StudentID) Экспорт

	Попытка
		ИдентификаторСтудента = Новый УникальныйИдентификатор(Строка(StudentID));
	Исключение
		Возврат Новый Структура("Успешно,Код,Сообщение,Студент", Ложь, 400, "Некорректный student_id", Неопределено);
	КонецПопытки;

	СсылкаСтудента = Справочники.Студенты.ПолучитьСсылку(ИдентификаторСтудента);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Студенты.Ссылка КАК Студент
	|ИЗ
	|	Справочник.Студенты КАК Студенты
	|ГДЕ
	|	Студенты.Ссылка = &Студент
	|	И НЕ Студенты.ПометкаУдаления";

	Запрос.УстановитьПараметр("Студент", СсылкаСтудента);

	Выборка = Запрос.Выполнить().Выбрать();

	Если НЕ Выборка.Следующий() Тогда
		Возврат Новый Структура("Успешно,Код,Сообщение,Студент", Ложь, 404, "Студент не найден", Неопределено);
	КонецЕсли;

	Возврат Новый Структура("Успешно,Код,Сообщение,Студент", Истина, 200, "", Выборка.Студент);

КонецФункции