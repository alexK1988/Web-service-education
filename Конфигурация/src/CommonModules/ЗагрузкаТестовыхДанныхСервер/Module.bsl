		ИмяДокумента = ПолучитьПолеСтрокиМакета(Данные, "Документ");
		КлючДокумента = НормализоватьКлюч(ИмяДокумента);

		Документ = ДокументыПоИменам.Получить(КлючДокумента);

		Если Документ = Неопределено Тогда

			Документ = Документы.ПосещениеЗанятия.СоздатьДокумент();
			Документ.Дата = СтрокаВДату(ПолучитьПолеСтрокиМакета(Данные, "Дата"));

			Организация = ПолучитьИзСоответствия(Организации, ПолучитьПолеСтрокиМакета(Данные, "Организация"));
			УчебныйПериод = ПолучитьИзСоответствия(УчебныеПериоды, ПолучитьПолеСтрокиМакета(Данные, "УчебныйПериод"));
			УчебнаяГруппа = ПолучитьИзСоответствия(УчебныеГруппы, ПолучитьПолеСтрокиМакета(Данные, "УчебнаяГруппа"));
			Дисциплина = ПолучитьИзСоответствия(Дисциплины, ПолучитьПолеСтрокиМакета(Данные, "Дисциплина"));
			Преподаватель = ПолучитьИзСоответствия(Преподаватели, ПолучитьПолеСтрокиМакета(Данные, "Преподаватель"));

			Если ЗначениеЗаполнено(Организация) Тогда
				Документ.Организация = Организация;
			КонецЕсли;

			Если ЗначениеЗаполнено(УчебныйПериод) Тогда
				Документ.УчебныйПериод = УчебныйПериод;
			КонецЕсли;

			Если ЗначениеЗаполнено(УчебнаяГруппа) Тогда
				Документ.УчебнаяГруппа = УчебнаяГруппа;
			КонецЕсли;

			Если ЗначениеЗаполнено(Дисциплина) Тогда
				Документ.Дисциплина = Дисциплина;
			КонецЕсли;

			Если ЗначениеЗаполнено(Преподаватель) Тогда
				Документ.Преподаватель = Преподаватель;
			КонецЕсли;

			Документ.ДатаЗанятия = СтрокаВДату(ПолучитьПолеСтрокиМакета(Данные, "ДатаЗанятия"));

			ДокументыПоИменам.Вставить(КлючДокумента, Документ);

		КонецЕсли;

		Студент = ПолучитьИзСоответствия(Студенты, ПолучитьПолеСтрокиМакета(Данные, "Студент"));
		ПричинаОтсутствия = ПолучитьИзСоответствия(ПричиныОтсутствия, ПолучитьПолеСтрокиМакета(Данные, "ПричинаОтсутствия"));

		Если НЕ ЗначениеЗаполнено(Студент) Тогда
			Сообщить("Не найден студент для посещения занятия: " + ПолучитьПолеСтрокиМакета(Данные, "Студент"));
			Продолжить;
		КонецЕсли;

		СтрокаТЧ = Документ.Посещаемость.Добавить();
		СтрокаТЧ.Студент = Студент;
		СтрокаТЧ.ВидПосещения = ПолучитьВидПосещения(ПолучитьПолеСтрокиМакета(Данные, "ВидПосещения"));

		Если ЗначениеЗаполнено(ПричинаОтсутствия) Тогда
			СтрокаТЧ.ПричинаОтсутствия = ПричинаОтсутствия;
		КонецЕсли;

		СтрокаТЧ.Комментарий = ПолучитьПолеСтрокиМакета(Данные, "Комментарий");

	КонецЦикла;

	Для Каждого Пара Из ДокументыПоИменам Цикл
		
		Попытка
			Пара.Значение.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Не удалось провести посещение занятия: " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;

КонецПроцедуры

Функция СтрокаВремяВДату(ЗначениеСтрокой)

	ЗначениеСтрокой = СокрЛП(Строка(ЗначениеСтрокой));

	Если ПустаяСтрока(ЗначениеСтрокой) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Ожидаемый формат: ЧЧ:ММ
	Часы = Число(Лев(ЗначениеСтрокой, 2));
	Минуты = Число(Сред(ЗначениеСтрокой, 4, 2));

	Возврат Дата(1, 1, 1, Часы, Минуты, 0);

КонецФункции

Процедура ЗагрузитьФормированиеРасписанияИзМакета(Макет)

	Строки = ПолучитьСтрокиРазделаМакета(Макет, "ФормированиеРасписания");

	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Организации = ПолучитьСоответствиеСправочникаПоНаименованию(Справочники.Организации);
	УчебныеПериоды = ПолучитьСоответствиеСправочникаПоНаименованию(Справочники.УчебныеПериоды);
	УчебныеГруппы = ПолучитьСоответствиеСправочникаПоНаименованию(Справочники.УчебныеГруппы);
	Дисциплины = ПолучитьСоответствиеСправочникаПоНаименованию(Справочники.Дисциплины);
	ВидыЗанятий = ПолучитьСоответствиеСправочникаПоНаименованию(Справочники.ВидыЗанятий);
	Преподаватели = ПолучитьСоответствиеСправочникаПоНаименованию(Справочники.Преподаватели);
	Аудитории = ПолучитьСоответствиеСправочникаПоНаименованию(Справочники.Аудитории);

	ДокументыПоИменам = Новый Соответствие;

	Для Каждого Данные Из Строки Цикл

		ИмяДокумента = ПолучитьПолеСтрокиМакета(Данные, "Документ");
		КлючДокумента = НормализоватьКлюч(ИмяДокумента);

		Если ПустаяСтрока(КлючДокумента) Тогда
			Продолжить;
		КонецЕсли;

		Документ = ДокументыПоИменам.Получить(КлючДокумента);

		Если Документ = Неопределено Тогда

			Документ = Документы.ФормированиеРасписания.СоздатьДокумент();
			Документ.Дата = СтрокаВДату(ПолучитьПолеСтрокиМакета(Данные, "Дата"));

			Организация = ПолучитьИзСоответствия(Организации, ПолучитьПолеСтрокиМакета(Данные, "Организация"));
			УчебныйПериод = ПолучитьИзСоответствия(УчебныеПериоды, ПолучитьПолеСтрокиМакета(Данные, "УчебныйПериод"));
			УчебнаяГруппа = ПолучитьИзСоответствия(УчебныеГруппы, ПолучитьПолеСтрокиМакета(Данные, "УчебнаяГруппа"));

			Если ЗначениеЗаполнено(Организация) Тогда
				Документ.Организация = Организация;
			КонецЕсли;

			Если ЗначениеЗаполнено(УчебныйПериод) Тогда
				Документ.УчебныйПериод = УчебныйПериод;
			КонецЕсли;

			Если ЗначениеЗаполнено(УчебнаяГруппа) Тогда
				Документ.УчебнаяГруппа = УчебнаяГруппа;
			КонецЕсли;

			Документ.Ответственный = ПолучитьПолеСтрокиМакета(Данные, "Ответственный");
			Документ.Комментарий = ПолучитьПолеСтрокиМакета(Данные, "Комментарий");

			ДокументыПоИменам.Вставить(КлючДокумента, Документ);

		КонецЕсли;

		Дисциплина = ПолучитьИзСоответствия(Дисциплины, ПолучитьПолеСтрокиМакета(Данные, "Дисциплина"));
		ВидЗанятия = ПолучитьИзСоответствия(ВидыЗанятий, ПолучитьПолеСтрокиМакета(Данные, "ВидЗанятия"));
		Преподаватель = ПолучитьИзСоответствия(Преподаватели, ПолучитьПолеСтрокиМакета(Данные, "Преподаватель"));
		Аудитория = ПолучитьИзСоответствия(Аудитории, ПолучитьПолеСтрокиМакета(Данные, "Аудитория"));

		СтрокаТЧ = Документ.Занятия.Добавить();
		СтрокаТЧ.ДеньНедели = СтрокаВЧисло(ПолучитьПолеСтрокиМакета(Данные, "ДеньНедели"));
		СтрокаТЧ.НомерПары = СтрокаВЧисло(ПолучитьПолеСтрокиМакета(Данные, "НомерПары"));
		СтрокаТЧ.ВремяНачала = СтрокаВремяВДату(ПолучитьПолеСтрокиМакета(Данные, "ВремяНачала"));
		СтрокаТЧ.ВремяОкончания = СтрокаВремяВДату(ПолучитьПолеСтрокиМакета(Данные, "ВремяОкончания"));

		Если ЗначениеЗаполнено(Дисциплина) Тогда
			СтрокаТЧ.Дисциплина = Дисциплина;
		КонецЕсли;

		Если ЗначениеЗаполнено(ВидЗанятия) Тогда
			СтрокаТЧ.ВидЗанятия = ВидЗанятия;
		КонецЕсли;

		Если ЗначениеЗаполнено(Преподаватель) Тогда
			СтрокаТЧ.Преподаватель = Преподаватель;
		КонецЕсли;

		Если ЗначениеЗаполнено(Аудитория) Тогда
			СтрокаТЧ.Аудитория = Аудитория;
		КонецЕсли;

	КонецЦикла;

	Для Каждого Пара Из ДокументыПоИменам Цикл

		Попытка
			Пара.Значение.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Не удалось провести формирование расписания: " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры