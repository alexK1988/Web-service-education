Функция НормализоватьКлюч(Значение)

	Возврат ВРег(СокрЛП(Строка(Значение)));

КонецФункции

Функция ПолучитьПолеСтрокиМакета(Данные, ИмяПоля, ЗначениеПоУмолчанию = "")

	ЗначениеПоля = ЗначениеПоУмолчанию;

	Если Данные.Свойство(ИмяПоля, ЗначениеПоля) Тогда
		Возврат ЗначениеПоля;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ПолучитьИзСоответствия(СоответствиеДанных, Ключ)

	Ключ = НормализоватьКлюч(Ключ);

	Если ПустаяСтрока(Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = СоответствиеДанных.Получить(Ключ);

	Если Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьСоответствиеСправочникаПоНаименованию(МенеджерСправочника)

	Результат = Новый Соответствие;

	Выборка = МенеджерСправочника.Выбрать();

	Пока Выборка.Следующий() Цикл
		
		Ключ = НормализоватьКлюч(Выборка.Наименование);
		
		Если НЕ ПустаяСтрока(Ключ) Тогда
			Результат.Вставить(Ключ, Выборка.Ссылка);
		КонецЕсли;
		
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьСоответствиеНаправленийПодготовки()

	Результат = Новый Соответствие;

	Выборка = Справочники.НаправленияПодготовки.Выбрать();

	Пока Выборка.Следующий() Цикл
		
		КлючНаименование = НормализоватьКлюч(Выборка.Наименование);
		
		Если НЕ ПустаяСтрока(КлючНаименование) Тогда
			Результат.Вставить(КлючНаименование, Выборка.Ссылка);
		КонецЕсли;
		
		КлючКод = НормализоватьКлюч(Выборка.КодНаправления);
		
		Если НЕ ПустаяСтрока(КлючКод) Тогда
			Результат.Вставить(КлючКод, Выборка.Ссылка);
		КонецЕсли;
		
	КонецЦикла;

	Возврат Результат;

КонецФункции

