Функция ПолучитьВидОценки(ВидОценкиСтрокой)

	ВидОценкиСтрокой = НормализоватьКлюч(ВидОценкиСтрокой);

	Если ВидОценкиСтрокой = "ЗАЧЕТ" Тогда
		Возврат Перечисления.ВидыОценок.Зачет;
	КонецЕсли;

	Если ВидОценкиСтрокой = "КОНТРОЛЬНАЯ РАБОТА" Тогда
		Возврат Перечисления.ВидыОценок.КонтрольнаяРабота;
	КонецЕсли;

	Если ВидОценкиСтрокой = "ТЕСТ" Тогда
		Возврат Перечисления.ВидыОценок.Тест;
	КонецЕсли;

	Если ВидОценкиСтрокой = "ПРАКТИЧЕСКАЯ РАБОТА" Тогда
		Возврат Перечисления.ВидыОценок.ПрактическаяРабота;
	КонецЕсли;

	Возврат Перечисления.ВидыОценок.Экзамен;

