			Результат.Вставить(Ключ, Выборка.Ссылка);
		КонецЕсли;
		
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьИлиСоздатьГруппуУчебныхГрупп(НаименованиеГруппы, СоответствиеУчебныхГрупп)

	НаименованиеГруппы = СокрЛП(Строка(НаименованиеГруппы));

	Если ПустаяСтрока(НаименованиеГруппы) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ключ = НормализоватьКлюч(НаименованиеГруппы);

	СуществующаяГруппа = СоответствиеУчебныхГрупп.Получить(Ключ);

	Если СуществующаяГруппа <> Неопределено Тогда
		Возврат СуществующаяГруппа;
	КонецЕсли;

	Группа = Справочники.УчебныеГруппы.СоздатьГруппу();
	Группа.Наименование = НаименованиеГруппы;
	Группа.Записать();

	СоответствиеУчебныхГрупп.Вставить(Ключ, Группа.Ссылка);

	Возврат Группа.Ссылка;

КонецФункции

