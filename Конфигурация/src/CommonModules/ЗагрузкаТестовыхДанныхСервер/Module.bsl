Процедура ЗагрузитьУчебныеГруппыИзМакета(Макет)

	Строки = ПолучитьСтрокиРазделаМакета(Макет, "УчебныеГруппы");

	СоответствиеОрганизаций = ПолучитьСоответствиеСправочникаПоНаименованию(Справочники.Организации);
	СоответствиеПодразделений = ПолучитьСоответствиеСправочникаПоНаименованию(Справочники.Подразделения);
	СоответствиеНаправлений = ПолучитьСоответствиеНаправленийПодготовки();
	СоответствиеФормОбучения = ПолучитьСоответствиеСправочникаПоНаименованию(Справочники.ФормыОбучения);
	СоответствиеУчебныхГрупп = ПолучитьСоответствиеУчебныхГрупп();

	Для Каждого Данные Из Строки Цикл
		
		КлючГруппы = НормализоватьКлюч(Данные.Наименование);
		СсылкаГруппы = СоответствиеУчебныхГрупп.Получить(КлючГруппы);

		Если СсылкаГруппы <> Неопределено Тогда
			Элемент = СсылкаГруппы.ПолучитьОбъект();
		Иначе
			Элемент = Справочники.УчебныеГруппы.СоздатьЭлемент();
			Элемент.Наименование = Данные.Наименование;
		КонецЕсли;

		Родитель = ПолучитьИлиСоздатьГруппуУчебныхГрупп(Данные.Родитель, СоответствиеУчебныхГрупп);
		Организация = ПолучитьИзСоответствия(СоответствиеОрганизаций, Данные.Организация);
		Подразделение = ПолучитьИзСоответствия(СоответствиеПодразделений, Данные.Подразделение);
		Направление = ПолучитьИзСоответствия(СоответствиеНаправлений, Данные.НаправлениеПодготовки);
		ФормаОбучения = ПолучитьИзСоответствия(СоответствиеФормОбучения, Данные.ФормаОбучения);

		Если ЗначениеЗаполнено(Родитель) Тогда
			Элемент.Родитель = Родитель;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Организация) Тогда
			Элемент.Организация = Организация;
		Иначе
			Сообщить("Не найдена организация для группы " + Данные.Наименование + ": " + Данные.Организация);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Подразделение) Тогда
			Элемент.Подразделение = Подразделение;
		Иначе
			Сообщить("Не найдено подразделение для группы " + Данные.Наименование + ": " + Данные.Подразделение);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Направление) Тогда
			Элемент.НаправлениеПодготовки = Направление;
		Иначе
			Сообщить("Не найдено направление подготовки для группы " + Данные.Наименование + ": " + Данные.НаправлениеПодготовки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ФормаОбучения) Тогда
			Элемент.ФормаОбучения = ФормаОбучения;
		Иначе
			Сообщить("Не найдена форма обучения для группы " + Данные.Наименование + ": " + Данные.ФормаОбучения);
		КонецЕсли;
		
		Элемент.Курс = СтрокаВЧисло(Данные.Курс);
		Элемент.ГодПоступления = СтрокаВЧисло(Данные.ГодПоступления);
		Элемент.Активна = СтрокаВБулево(Данные.Активна);
		
		Элемент.Записать();

		Если СсылкаГруппы = Неопределено Тогда
			СоответствиеУчебныхГрупп.Вставить(КлючГруппы, Элемент.Ссылка);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗагрузитьУчебныеПланыИзМакета(Макет)

	Строки = ПолучитьСтрокиРазделаМакета(Макет, "УчебныеПланы");

	Для Каждого Данные Из Строки Цикл
		
		Если ЗначениеЗаполнено(Справочники.УчебныеПланы.НайтиПоНаименованию(Данные.Наименование)) Тогда
			Продолжить;
		КонецЕсли;

		Направление = НайтиСправочникПоНаименованию(Справочники.НаправленияПодготовки, Данные.НаправлениеПодготовки);
		УчебныйПериод = НайтиСправочникПоНаименованию(Справочники.УчебныеПериоды, Данные.УчебныйПериод);

		Элемент = Справочники.УчебныеПланы.СоздатьЭлемент();
		Элемент.Наименование = Данные.Наименование;
		
		Если ЗначениеЗаполнено(Направление) Тогда
			Элемент.НаправлениеПодготовки = Направление;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(УчебныйПериод) Тогда
			Элемент.УчебныйПериод = УчебныйПериод;
		КонецЕсли;
		
		Элемент.ГодУтверждения = СтрокаВЧисло(Данные.ГодУтверждения);
		Элемент.ДатаУтверждения = СтрокаВДату(Данные.ДатаУтверждения);
		Элемент.Активен = СтрокаВБулево(Данные.Активен);
